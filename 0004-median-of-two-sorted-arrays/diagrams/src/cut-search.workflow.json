  {
   "id": "swap",
   "lane": "setup",
   "col": 0,
   "type": "frontend",
   "icon": "start",
   "label": "Shorter array first",
   "sublabel": "swap if A is longer"
  },
  {
   "id": "half",
   "lane": "setup",
   "col": 1,
   "type": "backend",
   "label": "half = (m+n+1)/2",
   "sublabel": "search cutA in 0..m"
  },
  {
   "id": "probe",
   "lane": "probe",
   "col": 2,
   "type": "backend",
   "label": "Probe",
   "sublabel": "cutA = middle of lo..hi",
   "tag": "cutB = half - cutA"
  },
  {
   "id": "read",
   "lane": "probe",
   "col": 3,
   "type": "database",
   "label": "Read 4 neighbours",
   "sublabel": "MIN / MAX at an edge"
  },
  {
   "id": "c1",
   "lane": "probe",
   "col": 4,
   "type": "security",
   "icon": "decision",
   "label": "aLeft > bRight ?"
  },
  {
   "id": "c2",
   "lane": "probe",
   "col": 5,
   "type": "security",
   "icon": "decision",
   "label": "bLeft > aRight ?"
  },
  {
   "id": "left",
   "lane": "move",
   "col": 4,
   "type": "messagebus",
   "label": "hi = cutA - 1",
   "sublabel": "A gave too much"
  },
  {
   "id": "right",
   "lane": "move",
   "col": 5,
   "type": "messagebus",
   "label": "lo = cutA + 1",
   "sublabel": "A must give more"
  },
  {
   "id": "found",
   "lane": "answer",
   "col": 5,
   "type": "backend",
   "icon": "success",
   "label": "Median wall found",
   "sublabel": "odd: leftMax",
   "tag": "even: (leftMax+rightMin)/2.0"
  }
 ],
