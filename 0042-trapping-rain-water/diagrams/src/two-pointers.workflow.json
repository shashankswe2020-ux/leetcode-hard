  },
  {
   "id": "addright",
   "lane": "mirror",
   "col": 4,
   "type": "messagebus",
   "label": "water += maxRight - bar",
   "sublabel": "right--, final: crown is left"
  },
  {
   "id": "done",
   "lane": "answer",
   "col": 5,
   "type": "backend",
   "icon": "success",
   "label": "return water",
