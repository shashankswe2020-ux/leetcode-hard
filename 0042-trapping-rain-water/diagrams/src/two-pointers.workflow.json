  },
  {
   "id": "addleft",
   "lane": "settle",
   "col": 4,
   "type": "backend",
   "label": "water += maxLeft - bar",
   "sublabel": "final: the crown is right"
  },
  {
   "id": "stepleft",
   "lane": "settle",
   "col": 5,
   "type": "messagebus",
   "label": "left++",
   "sublabel": "one bar settled"
