   "id": "test",
   "lane": "scan",
   "col": 2,
   "type": "security",
   "icon": "decision",
   "label": "sum + num > limit ?",
   "sublabel": "strictly greater"
  },
  {
   "id": "cutn",
   "lane": "cut",
   "col": 3,
   "type": "messagebus",
   "label": "count++, sum = num",
   "sublabel": "cut before num"
  },
  {
   "id": "addn",
   "lane": "add",
   "col": 3,
   "type": "backend",
   "label": "sum += num",
   "sublabel": "piece grows"
  },
  {
   "id": "done",
   "lane": "answer",
   "col": 4,
   "type": "backend",
   "icon": "success",
   "label": "return count",
   "sublabel": "fewest pieces, O(n)",
   "tag": "limit 13: 3 pieces"
  }
 ],
 "edges": [
